# ─── Base de datos (Neon) ────────────────────────────────────────────────
# DATABASE_URL: conexión *pooled* (con -pooler en el host). La usa la app.
# DIRECT_URL:   conexión *unpooled* (sin -pooler). La usan las migraciones.
DATABASE_URL="postgresql://neondb_owner:npg_OeyL9K7oTpRV@ep-winter-glitter-ackw78on-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_OeyL9K7oTpRV@ep-winter-glitter-ackw78on.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Better Auth ─────────────────────────────────────────────────────────
# Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# ⚠️ Al desplegar, BETTER_AUTH_URL debe ser el dominio real (https://…), no
# localhost: de él dependen las cookies de sesión y los redirects.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Acceso ──────────────────────────────────────────────────────────────
# Dominio institucional permitido para dar de alta cuentas.
# Vacío o sin definir = sin restricción de dominio (útil en la rama spike).
ALLOWED_EMAIL_DOMAIN=""

# ─── Evidencia (Plan RRD) ────────────────────────────────────────────────
# Carpeta en disco donde se guardan los adjuntos de las actividades.
# Debe quedar FUERA de public/ — se sirven vía /api/evidencia/[id] con sesión validada.
#
# ⚠️ Solo sirve con un filesystem persistente (local, VM, contenedor con volumen).
# En serverless (Vercel) el disco es de solo lectura salvo /tmp, y /tmp es
# efímero y no se comparte entre instancias: las subidas fallarán. Para desplegar
# ahí hay que cambiar src/server/storage.ts por un blob store (S3, Vercel Blob).
EVIDENCE_DIR=".uploads/evidencia"

# ─── Seed ────────────────────────────────────────────────────────────────
# Contraseña asignada a las cuentas de prueba que crea prisma/seed.ts.
SEED_PASSWORD="dgrd2026"
