# ─── Base de datos (Neon) ────────────────────────────────────────────────
# DATABASE_URL: conexión *pooled* (con -pooler en el host). La usa la app.
# DIRECT_URL:   conexión *unpooled* (sin -pooler). La usan las migraciones.
DATABASE_URL=""
DIRECT_URL=""

# ─── Better Auth ─────────────────────────────────────────────────────────
# Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# ⚠️ Al desplegar, BETTER_AUTH_URL debe ser el dominio real (https://…), no
# localhost: de él dependen las cookies de sesión y los redirects.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Acceso ──────────────────────────────────────────────────────────────
# Dominio institucional permitido para dar de alta cuentas.
# Vacío o sin definir = sin restricción de dominio (útil en la rama spike).
ALLOWED_EMAIL_DOMAIN=""

# ─── Evidencia (Plan RRD) ────────────────────────────────────────────────
# El backend se elige solo: si hay BLOB_READ_WRITE_TOKEN usa Vercel Blob
# (store PRIVADO); si no, disco local en EVIDENCE_DIR. En serverless SOLO
# funciona Blob (el filesystem es de solo lectura salvo /tmp, y /tmp es efímero).
#
# Vercel inyecta BLOB_READ_WRITE_TOKEN al conectar el store al proyecto.
# Para usar Blob también en local: `vercel env pull .env.local`, o pega el token
# del dashboard (Storage → tu store → .env.local).
BLOB_READ_WRITE_TOKEN=""

# Carpeta en disco para el modo local. Debe quedar FUERA de public/:
# los archivos se sirven vía /api/evidencia/[id], que valida la sesión.
EVIDENCE_DIR=".uploads/evidencia"

# ─── Seed ────────────────────────────────────────────────────────────────
# Contraseña asignada a las cuentas de prueba que crea prisma/seed.ts.
SEED_PASSWORD="dgrd2026"
